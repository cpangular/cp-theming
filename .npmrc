# Hoist packages that the Angular vite dev server needs to resolve from
# .angular/vite-root/docs, which is outside the demos/docs/ subtree and
# therefore cannot reach demos/docs/node_modules via directory traversal.
public-hoist-pattern[]=rxjs*
public-hoist-pattern[]=tslib
public-hoist-pattern[]=zone.js

# cpdevtools/git-flow (release tooling) is published to GitHub Packages.
@cpdevtools:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
