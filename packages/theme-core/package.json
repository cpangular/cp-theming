{
  "name": "@cpangular/cp-theming-core",
  "version": "0.1.0-dev.0",
  "description": "CSS variable-based theming system. Framework-agnostic core.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./scss/*": "./scss/*",
    "./css/core": "./dist/core.css",
    "./css/presets/azure-blue": "./dist/presets/azure-blue.css",
    "./css/presets/rose-red": "./dist/presets/rose-red.css",
    "./css/presets/cyan-orange": "./dist/presets/cyan-orange.css",
    "./css/presets/magenta-violet": "./dist/presets/magenta-violet.css"
  },
  "scripts": {
    "build": "wireit",
    "dev": "wireit",
    "test": "wireit",
    "test.css": "wireit",
    "test.api": "wireit",
    "render": "node test/render.ts",
    "github.actions.build": "wireit",
    "github.actions.test": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build.css",
        "build.ts"
      ]
    },
    "build.css": {
      "command": "sass --style=expanded scss/core.scss:dist/core.css scss/theme-vars.scss:dist/theme-vars.css scss/presets/azure-blue.scss:dist/presets/azure-blue.css scss/presets/rose-red.scss:dist/presets/rose-red.css scss/presets/cyan-orange.scss:dist/presets/cyan-orange.css scss/presets/magenta-violet.scss:dist/presets/magenta-violet.css",
      "files": [
        "scss/**/*.scss"
      ],
      "output": [
        "dist/**/*.css",
        "dist/**/*.css.map"
      ]
    },
    "build.ts": {
      "command": "tsc --build --pretty",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "dist/**/*.js.map",
        "dist/**/*.d.ts.map",
        ".tsbuildinfo"
      ]
    },
    "dev": {
      "dependencies": [
        "dev.css",
        "dev.ts"
      ]
    },
    "dev.css": {
      "command": "sass --watch --style=expanded scss/theme-vars.scss:dist/theme-vars.css",
      "service": true
    },
    "dev.ts": {
      "command": "tsc --build --watch --pretty",
      "service": true
    },
    "test": {
      "dependencies": [
        "test.css",
        "test.api"
      ]
    },
    "test.css": {
      "command": "node --test \"test/css/*.test.ts\"",
      "files": [
        "scss/**/*.scss",
        "test/css/**",
        "test/lib/**",
        "test/fixtures/**",
        "../theme-ng-material/scss/**/*.scss",
        "../../demos/docs/src/**/*.scss",
        "../../angular.json",
        "package.json"
      ],
      "output": []
    },
    "test.api": {
      "command": "vitest run",
      "files": [
        "src/**/*.ts",
        "test/api/**",
        "test/lib/**",
        "scss/**/*.scss",
        "vitest.config.ts",
        "package.json"
      ],
      "output": []
    },
    "github.actions.build": {
      "dependencies": [
        "build"
      ]
    },
    "github.actions.test": {
      "dependencies": [
        "test"
      ]
    }
  },
  "devDependencies": {
    "colorjs.io": "^0.7.1",
    "sass": "^1.101.0",
    "typescript": "^5.8.0",
    "wireit": "^0.14.12"
  }
}
