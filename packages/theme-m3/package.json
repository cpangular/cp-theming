{
  "name": "@cpangular/cp-theming-m3",
  "version": "0.0.0-MAIN",
  "description": "Plain M3 CSS token adapter for @cpangular/cp-theming-core. No Angular Material dependency.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./scss/m3-core": {
      "sass": "./scss/_m3-core.scss"
