{
  "name": "@cpangular/cp-theming-ng-material",
  "version": "0.1.0-dev.0",
  "description": "Angular Material M3 adapter for @cpangular/cp-theming-core. Maps --color--* vars to --mat-sys-* tokens.",
  "sideEffects": false,
  "exports": {
    "./scss/*": "./scss/*",
    "./css/material-core": "./dist/material-core.css",
    "./css/material-overrides": "./dist/material-overrides.css"
  },
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "github.actions.build": "wireit",
    "github.actions.test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "sass --style=expanded scss/material-core.scss:dist/material-core.css scss/material-overrides.scss:dist/material-overrides.css",
      "files": [
        "scss/**/*.scss"
      ],
      "output": [
        "dist/**/*.css",
        "dist/**/*.css.map"
      ]
    },
    "test": {
      "command": "node --test \"test/css/*.test.ts\"",
      "files": [
        "scss/**/*.scss",
        "test/**",
        "../theme-core/scss/**/*.scss",
        "../theme-core/test/lib/**",
        "package.json"
      ],
      "output": []
    },
    "github.actions.build": {
      "dependencies": [
        "build"
      ]
    },
    "github.actions.test": {
      "dependencies": [
        "test"
      ]
    }
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@cpangular/cp-theming-ng-core": "workspace:*",
    "@cpangular/cp-theming-core": "workspace:*"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "sass": "^1.101.0"
  }
}
