{
  "name": "@acme/theme-material",
  "version": "0.0.0-MAIN",
  "private": true,
  "description": "Example: a company's theme package for its Angular Material apps, built on @acme/theme and @cpangular/cp-theming-ng-material.",
  "exports": {
    ".": {
      "sass": "./_index.scss"
    },
    "./scss/*": "./scss/*",
    "./css": "./dist/acme-material.css"
  },
  "files": [
    "_index.scss",
    "scss",
    "dist"
  ],
  "scripts": {
    "build": "sass --no-source-map --style=expanded --load-path=node_modules scss/acme-material.scss:dist/acme-material.css",
    "pack:check": "pnpm run build && pnpm pack --dry-run",
    "github.actions.build": "pnpm run build"
  },
  "dependencies": {
    "@acme/theme": "workspace:^"
  },
  "peerDependencies": {
    "@cpangular/cp-theming-core": "workspace:^",
    "@cpangular/cp-theming-ng-material": "workspace:^"
  },
  "devDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/material": "^22.0.0",
    "sass": "^1.101.0"
  }
}
