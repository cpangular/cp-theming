{
  "name": "docs",
  "version": "0.0.0-MAIN",
  "private": true,
  "description": "cp-theming documentation site",
  "scripts": {
    "predev": "lsof -ti :4200 | xargs kill -9 2>/dev/null || true",
    "learn": "node scripts/learn.ts",
    "start": "node scripts/learn.ts && ng serve docs",
    "dev": "node scripts/learn.ts && ng serve docs --configuration development",
    "build": "wireit",
    "build.site": "wireit",
    "build:dev": "node scripts/learn.ts && ng build docs --configuration development",
    "test": "node --test \"test/*.test.ts\"",
    "render": "node test/render.ts",
    "chain": "node test/chain.ts",
    "github.actions.build": "wireit",
    "github.actions.test": "node --test \"test/*.test.ts\"",
    "github.actions.pack": "gitflow pack"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@cpangular/cp-theming-core": "workspace:*",
    "@cpangular/cp-theming-ng-core": "workspace:*",
    "@cpangular/cp-theming-ng-material": "workspace:*",
    "highlight.js": "^11.11.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "sass": "^1.101.0"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build.site"
      ]
    },
    "build.site": {
      "command": "node scripts/learn.ts && ng build docs --configuration production && node scripts/assemble.ts",
      "dependencies": [
        "../../packages/theme-core:build",
        "../../packages/theme-ng-material:build",
        "../demo-core:build"
      ]
    },
    "github.actions.build": {
      "dependencies": [
        "build"
      ]
    }
  }
}
