{
  "name": "demo-core",
  "version": "0.0.0-MAIN",
  "private": true,
  "description": "Demonstrates @cpangular/cp-theming-core with vanilla TS and Vite.",
  "type": "module",
  "scripts": {
    "dev": "pnpm run demo-core.dev",
    "build": "wireit",
    "preview": "pnpm run demo-core.preview",
    "demo-core.dev": "vite",
    "demo-core.preview": "vite preview",
    "github.actions.build": "wireit"
  },
  "wireit": {
    "build": {
      "command": "vite build"
    },
    "github.actions.build": {
      "dependencies": [
        "build"
      ]
    }
  },
  "dependencies": {
    "@cpangular/cp-theming-core": "workspace:*"
  },
  "devDependencies": {
    "sass": "^1.101.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
