{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "packages",
  "projects": {
    "theme-ng-core": {
      "projectType": "library",
      "root": "packages/theme-ng-core",
      "sourceRoot": "packages/theme-ng-core/src",
      "prefix": "cpa",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "packages/theme-ng-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "packages/theme-ng-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
